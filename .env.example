# LLM Configuration
# Options: "openai" or "local"
LLM_PROVIDER=openai
# Model name (e.g., gpt-4o-mini for OpenAI, or your local model name)
LLM_MODEL=gpt-4o-mini

# OpenAI API Configuration (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM Configuration (required when LLM_PROVIDER=local)
# Base URL for your local LLM server (e.g., http://localhost:1234/v1 for LM Studio)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# API key for local LLM (many don't require this, use "not-needed")
LOCAL_LLM_API_KEY=not-needed
# Temperature for local LLM (optional, defaults to model default)
LOCAL_LLM_TEMPERATURE=0.7

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=personal-gpt-index
EMBEDDING_DIMENSION=1536

# Cohere Configuration (Required for Reranking)
COHERE_API_KEY=your_cohere_api_key_here

# Database Configuration
# PostgreSQL connection string
# For local dev: localhost:5432
# For Docker: postgres:5432
DATABASE_URL=postgresql://aibank:aibankpassword@localhost:5432/aibank_db

# Docker Postgres Configuration (used by docker-compose)
POSTGRES_USER=aibank
POSTGRES_PASSWORD=aibankpassword
POSTGRES_DB=aibank_db

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=personal_gpt_collection

# Server Configuration
# Optional: Port to run the server on (default: 8000)
PORT=8000
